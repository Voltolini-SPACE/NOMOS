{
  "name": "reach-exa-search",
  "version": "1.0.0",
  "description": "busca semantica pela Exa via proxy MCP",
  "entry": "reach_exa_search.py",
  "permissions": [
    "A1_WRITE_LOCAL",
    "A2_NET_EGRESS",
    "A3_CRED_USE",
    "A3_CONNECTOR_USE"
  ],
  "modalities": [
    "texto",
    "web"
  ],
  "keywords": [
    "busca",
    "semantica",
    "exa"
  ],
  "local_only_capable": false,
  "cloud_required": false,
  "compatible_nomos_version": ">=0.11",
  "requires": [
    {
      "tipo": "binario",
      "nome": "mcporter",
      "obrigatorio": true
    },
    {
      "tipo": "servidor_mcp",
      "nome": "exa",
      "obrigatorio": true
    },
    {
      "tipo": "chave",
      "nome": "exa_api_key",
      "obrigatorio": true,
      "descricao": "chave da Exa"
    }
  ],
  "files": {}
}
